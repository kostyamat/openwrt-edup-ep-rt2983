#!/bin/sh

# ====================================================================
# 1. МЕРЕЖА: Зміна IP-адреси LAN
# ====================================================================
uci set network.lan.ipaddr='192.168.2.1/24'
uci del network.lan.netmask 2>/dev/null 

# ====================================================================
# 2. МЕРЕЖА: DNS на WAN
# ====================================================================
uci set network.wan.peerdns='0'
uci del_list network.wan.dns 2>/dev/null
uci add_list network.wan.dns='1.1.1.1'
uci add_list network.wan.dns='8.8.8.8'

# ====================================================================
# 3. ДОСТУП: SSH/SFTP
# ====================================================================
uci set dropbear.@dropbear[0].PasswordAuth='on'
uci set dropbear.@dropbear[0].RootPasswordAuth='on'

# ====================================================================
# 4. WI-FI: Єдина мережа (Single SSID), Роумінг та Mesh
# ====================================================================
# Унікальний суфікс з MAC-адреси
MAC_CLEAN=$(cat /sys/class/net/eth0/address 2>/dev/null | tr -d ':' | tr 'a-z' 'A-Z')
[ -z "$MAC_CLEAN" ] && MAC_CLEAN=$(cat /sys/class/net/br-lan/address 2>/dev/null | tr -d ':' | tr 'a-z' 'A-Z')
SUFFIX=$(echo "$MAC_CLEAN" | grep -o '....$')
[ -z "$SUFFIX" ] && SUFFIX="XXXX"

# Дані твоєї мережі
WIFI_SSID="EDUP_${SUFFIX}"
WIFI_PASS="12345678"

# Mobility Domain (MDID) має бути однаковим на всіх роутерах у Mesh-мережі (4 hex-символи)
MDID="ed00"

# Вмикаємо всі фізичні радіомодулі
for r in $(uci show wireless | grep "=wifi-device" | cut -d. -f2 | cut -d= -f1); do
    uci set wireless.$r.disabled='0'
done

# Налаштовуємо всі існуючі точки доступу (AP) під ЄДИНУ мережу
for i in $(uci show wireless | grep "=wifi-iface" | cut -d. -f2 | cut -d= -f1); do
    MODE=$(uci -q get wireless.$i.mode)
    if [ -z "$MODE" ] || [ "$MODE" = "ap" ]; then
        uci set wireless.$i.disabled='0'
        uci set wireless.$i.ssid="$WIFI_SSID"
        uci set wireless.$i.encryption='psk2+ccmp'
        uci set wireless.$i.key="$WIFI_PASS"

        # Активація безшовного роумінгу (Fast Transition, RRM, BSS Transition)
        uci set wireless.$i.ieee80211r='1'
        uci set wireless.$i.mobility_domain="$MDID"
        uci set wireless.$i.ieee80211k='1'
        uci set wireless.$i.ieee80211v='1'
        uci set wireless.$i.bss_transition='1'
    fi
done

# Додаємо прихований інтерфейс 802.11s (Mesh) на діапазоні 5GHz (зазвичай radio1)
if uci -q get wireless.radio1 > /dev/null; then
    uci set wireless.mesh0='wifi-iface'
    uci set wireless.mesh0.device='radio1'
    uci set wireless.mesh0.ifname='mesh0'
    uci set wireless.mesh0.network='lan'
    uci set wireless.mesh0.mode='mesh'
    uci set wireless.mesh0.mesh_id="EDUP_MESH_BACKHAUL"
    uci set wireless.mesh0.encryption='sae' # WPA3 SAE - стандарт для 802.11s
    uci set wireless.mesh0.key="$WIFI_PASS"
fi

# ====================================================================
# 5. ЗБЕРЕЖЕННЯ І ФІНАЛІЗАЦІЯ
# ====================================================================
uci commit network
uci commit dropbear
uci commit wireless

exit 0